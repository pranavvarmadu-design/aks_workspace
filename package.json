{
  "name": "job-finder-resume-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension and scheduled backend: finds university and India industry jobs from legal sources and tailors a resume to each listing.",
  "scripts": {
    "build": "node build.mjs --minify",
    "start": "node --env-file-if-exists=.env backend/server.js",
    "collect": "node --env-file-if-exists=.env backend/server.js --once",
    "test": "node --test test/*.test.js",
    "e2e": "npm run build && node e2e/extension.e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "nodemailer": "^6.9.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
