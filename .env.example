# Backend configuration. Copy to .env and run: npm start
# Free key from https://developer.adzuna.com (needed for SG, EMEA and India listings)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

PORT=8787
COLLECT_INTERVAL_HOURS=24
KEEP_DAYS=45
# Posting pages read per run to check visa sponsorship (robots.txt obeyed, 4 s apart)
READ_POSTINGS_PER_RUN=40
# Set this when the backend is reachable from the internet; enter the same value in the extension.
API_TOKEN=

# Optional email digest of new listings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_FROM=
DIGEST_TO=
